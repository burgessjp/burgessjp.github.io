---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import PostRow from '../components/PostRow.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { standalonePosts } from '../data/standalone-posts';

const posts = [
  ...(await getCollection('blog')).map((p) => ({ ...p.data, url: `/blog/${p.id}/` })),
  ...standalonePosts.map(({ url, ...data }) => ({ ...data, url })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 6);
---

<BaseLayout title="Home" description="PENG 的技术博客 — Android、React Native、AI 辅助开发、Claude Code 实践">
  <Navbar />
  <main class="max-w-3xl mx-auto px-6 pb-16">
    <Hero />
    <div class="text-xs text-text-muted uppercase tracking-wider mb-4">最新文章</div>
    <div>
      {posts.map((post) => (
        <PostRow
          title={post.title}
          excerpt={post.excerpt}
          date={post.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit' }).replace(/\//g, '.')}
          href={post.url}
        />
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
