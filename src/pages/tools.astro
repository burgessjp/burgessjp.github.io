---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const tools: { title: string; description: string; tags: string[]; link: string }[] = [
  {
    title: 'MBTI 性格测试',
    description:
      '60 道情景题测出你的 16 型人格。宣纸墨色的中式视觉，答题进度自动保存在本地，结果页给出性格解析、适合方向与同款名人，可一键生成分享卡片。',
    tags: ['MBTI', '心理测试', 'Quiz'],
    link: '/mbti-test/',
  },
  {
    title: '物流工具箱',
    description:
      '为跨境物流场景打磨的两个小工具：打板计算器（纸箱装载方案与公英制单位切换）和美国地图标注测距（在地图上标注位置、估算运输范围）。',
    tags: ['物流', '打板计算器', '地图标注'],
    link: '/logistics-tools/',
  },
];
---

<BaseLayout title="Tools" description="PENG 的站内在线小工具">
  <Navbar />
  <main class="max-w-3xl mx-auto px-6 pt-16 pb-16">
    <h1 class="font-serif text-2xl font-bold mb-8">工具</h1>
    <div>
      {tools.map((tool) => (
        <div class="py-4 border-b border-border last:border-b-0">
          <h3 class="font-serif text-base font-bold text-text mb-1">
            <a href={tool.link} class="hover:text-accent">{tool.title}</a>
          </h3>
          <p class="text-sm text-text-muted leading-relaxed mb-2">{tool.description}</p>
          <div class="flex flex-wrap gap-2">
            {tool.tags.map((tag) => (
              <span class="text-xs px-2 py-0.5 rounded bg-bg-card text-accent">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
