---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Extract headings from markdown source (skip code blocks)
const body = post.body ?? '';
const bodyNoCode = body.replace(/```[\s\S]*?```/g, '');
const headingRegex = /^(#{2,3})\s+(.+)$/gm;
const headings = [];
let match;
while ((match = headingRegex.exec(bodyNoCode)) !== null) {
  const depth = match[1].length;
  const text = match[2].replace(/[*`\[\]]/g, '');
  const slug = text
    .toLowerCase()
    .trim()
    .replace(/\s+/g, '-')
    .replace(/[^a-z0-9一-鿿\-]/g, '')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
  headings.push({ depth, slug, text });
}

// Calculate reading time (Chinese: ~300 chars/min)
const chineseChars = body.replace(/[^一-鿿]/g, '').length;
const totalWords = body.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(chineseChars / 300 + totalWords / 200));
---

<BlogPost
  title={post.data.title}
  date={post.data.date}
  tags={post.data.tags}
  excerpt={post.data.excerpt}
  headings={headings}
  readingTime={readingTime}
>
  <Content />
</BlogPost>
